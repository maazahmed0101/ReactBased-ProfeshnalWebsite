              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns a welcome message and available endpoint groups. Expected: 200"
          },
          "response": []
        },
        {
          "name": "GET Unknown Route (Error 404)",
          "request": {
            "method": "GET",
            "header": [],
